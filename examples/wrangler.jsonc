{
  "name": "text-fight-words",
  "main": "wordnik-worker.js",
  "compatibility_date": "2026-11-01",
  "vars": { "ALLOWED_ORIGIN": "https://kgitwh21.github.io,http://localhost:4173" },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
